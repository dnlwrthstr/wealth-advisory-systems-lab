      "tier": "golden"
    },
    "properties": {
      "identifier": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "scheme": {
        "type": "keyword"
      },
      "scope": {
        "type": "keyword"
      },
      "documentId": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      }
    }
  }
}
