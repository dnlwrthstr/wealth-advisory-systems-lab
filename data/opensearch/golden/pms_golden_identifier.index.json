{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    }
  },
  "mappings": {
    "dynamic": false,
    "_meta": {
      "ontology": "Identifier",
      "ontology_version": "0.2.0",
      "source_entity": "derived from per-security golden records",
